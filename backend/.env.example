# DeepSeek API (text reasoning — OpenAI-compatible)
OPENAI_API_KEY=sk-your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# Zhipu API (vision / image analysis — GLM-4V-Flash, free tier)
ZHIPU_API_KEY=your-zhipu-key-here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_VISION_MODEL=glm-4v-flash

# JWT Auth
SECRET_KEY=change-this-to-a-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite for dev, change to PostgreSQL URL for prod)
DATABASE_URL=sqlite+aiosqlite:///./tcm_health.db

# ChromaDB vector store path
CHROMA_PERSIST_PATH=./chroma_db

# CORS - comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App settings
APP_ENV=development
APP_DEBUG=true
